# E2E専用の環境変数（D-02）。値はすべて明白なダミー。本番・開発の秘密値は絶対に入れない。
# `docker compose --env-file deploy/e2e/e2e.env` で渡す。これにより開発用の .env は読まれない。
# ※ compose.yaml の `${VAR:?}` はファイル単位で補間されるため、必須変数はここで必ず与える。

ENV=test

# 32バイト以上のbase64url。中身は 'A' を32個並べただけの明白なダミー。
APP_PEPPER=QUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUE

# CSRFのOrigin検証に使う。e2eコンテナのChromiumが開くオリジンと完全一致させる。
PUBLIC_BASE_URL=https://reverse-proxy

# Caddyが待ち受けるホスト名（ドットなし → local CAで証明書が発行される）
SITE_ADDRESS=reverse-proxy
HSTS_VALUE=max-age=0

# ENV=test のときだけ許される軽量Argon2（E2Eの待ち時間短縮）
ARGON2_TIME_COST=1
ARGON2_MEMORY_KIB=1024
ARGON2_PARALLELISM=1
ARGON2_MAX_CONCURRENCY=2
