# VPS 上の <APP_DIR>/.env として配置し、chmod 600（staging）。本番と pepper・ドメインを必ず分ける。
ENV=prod
# deploy.sh が書き換える。初回はこのままでよい。
APP_IMAGE=ghcr.io/OWNER/REPO-app@sha256:REPLACED_BY_DEPLOY_SH
PUBLIC_BASE_URL=https://staging.example.com
SITE_ADDRESS=staging.example.com
# 最初は短く。問題なければ 86400 → 31536000 と段階的に延ばす（戻せなくなるため）。
HSTS_VALUE=max-age=300
# 環境ごとに別々に生成（staging と共有しない）。紛失・変更すると全員ログイン不能。DBバックアップとは別経路で保管。
#   docker run --rm python:3.14-slim python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_PEPPER=
# 'deploy/deploy.sh tune' の推奨値を入れる（stagingと同じ値）
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=4
ARGON2_MAX_CONCURRENCY=2
