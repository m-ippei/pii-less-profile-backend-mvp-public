# VPS 上の <APP_DIR>/ops.env として配置し、chmod 600。commit しない。
# シェルから source される。空白を含む値は引用符で囲む。

# ---- backup.sh ----
BACKUP_ENABLED=1                 # staging は 0（合成データなのでバックアップ不要）
REQUIRE_OFFSITE=1                # production は 1（オフサイト転送に失敗したら異常終了）
# age の「公開鍵」。秘密鍵は VPS に置かない（age-keygen は手元PCで実行）
AGE_RECIPIENT=age1REPLACE_WITH_PUBLIC_KEY
# rclone のリモート:パス（rclone config で作成。例: r2:<bucket>/production）
RCLONE_REMOTE=
BACKUP_DIR=/var/backups/app
KEEP_LOCAL_DAYS=14               # ただし直近3件は日数に関わらず残す
REMOTE_KEEP_DAYS=60              # バケット側のライフサイクルルールで消す場合は大きめにしてよい
BACKUP_PING_URL=                 # 外形監視サービスの ping URL（任意。成功/失敗/未実行を検知）

# ---- monitor.sh ----
NOTIFY_URL=                      # 異常時に本文をPOSTする先（通知サービスの URL）。空なら通知しない
MONITOR_PING_URL=                # monitor 自体の死活用 ping URL（任意）
DISK_WARN_PCT=80                 # 推奨例。環境に合わせて調整
DISK_CRIT_PCT=90                 # 推奨例。環境に合わせて調整
JOURNAL_WARN_MB=800              # journald の上限に対する警告ライン
CERT_WARN_DAYS=14                # 証明書更新の余裕を見た警告日数
