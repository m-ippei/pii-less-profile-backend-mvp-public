# local用の設定例。`.env.example` からコピーして `.env` を作成する（.envはcommitしない）。
# stagingとproductionの値は別管理（このファイルには書かない）。

ENV=dev
# ブラウザに表示されるオリジン。ポートを変えたらこちらも合わせる（CSRFのOrigin検証に使用）。
PUBLIC_BASE_URL=https://localhost:8443
LOCAL_HTTPS_PORT=8443

# 必須。localではダミーでよいが、以下で生成した値を使う（空だと起動しない）:
#   docker run --rm python:3.14-slim python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_PEPPER=dummy-pepper-value-must-be-replaced-in-production

# Reverse Proxy
SITE_ADDRESS=localhost
# localではHSTSを無効化(max-age=0)。staging/productionでは max-age=31536000 等にする。
HSTS_VALUE=max-age=0

# Argon2（既定値。localで遅ければ下げてよい）
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=4
ARGON2_MAX_CONCURRENCY=2

# インメモリ rate limit の key 上限（既定10000）。容量 fail-closed を小さく観測したい時だけ下げる。
RATE_LIMIT_MAX_KEYS=10000